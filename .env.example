# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA_PROPERTY_ID="your-ga4-property-id"

# Server-side Firebase Admin credentials
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Optional fallback to explicit credentials instead of GOOGLE_APPLICATION_CREDENTIALS
# FIREBASE_CLIENT_EMAIL="..."

# RMIT VAL (AI alt-text review)
VAL_API_KEY="..."
VAL_BASE_URL="https://val-npe.rmit.edu.au/api"
VAL_MODEL="gpt-5.6-sol"
VAL_REASONING_EFFORT="low"